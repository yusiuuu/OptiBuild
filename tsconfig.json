  // TypeScript configuration for OptiBuild application
  // Defines compiler options and project structure for type checking
  "compilerOptions": {
    // JavaScript libraries to include in compilation
    "lib": ["dom", "dom.iterable", "esnext"],
    
    // Allow JavaScript files alongside TypeScript files
    "allowJs": true,
    
    // Target ECMAScript version for compilation
    "target": "ES6",
    
    // Skip type checking of declaration files for faster builds
    "skipLibCheck": true,
    
    // Enable strict type checking for better code quality
    "strict": true,
    
    // Don't emit JavaScript files (Next.js handles this)
    "noEmit": true,
    
    // Enable ES module interop for CommonJS compatibility
    "esModuleInterop": true,
    
    // Use ES modules for module system
    "module": "esnext",
    
    // Use bundler-based module resolution (Next.js)
    "moduleResolution": "bundler",
    
    // Allow importing JSON files as modules
    "resolveJsonModule": true,
    
    // Ensure each file is treated as a separate module
    "isolatedModules": true,
    
    // Preserve JSX syntax for Next.js processing
    "jsx": "preserve",
    
    // Enable incremental compilation for faster rebuilds
    "incremental": true,
    
